NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

MPESA_DARAJA_ENV=sandbox
KOPOKOPO_ENV=sandbox

# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`) — encrypts
# payment_gateways.config_json (Daraja/KopoKopo credentials at rest).
GATEWAY_CONFIG_KEY=

# Bearer token required on POST /api/cron/reconcile-payments and
# POST /api/cron/rent-reminders.
CRON_SECRET=

# Resend (payment receipt emails). Without RESEND_FROM_EMAIL on a verified
# domain, Resend's shared testing sender only delivers to your own account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS (Advanta) config is per-org and lives encrypted in sms_settings.config_json
# (same GATEWAY_CONFIG_KEY above encrypts it) — no env var needed here.
