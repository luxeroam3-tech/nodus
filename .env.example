NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

MPESA_DARAJA_ENV=sandbox
KOPOKOPO_ENV=sandbox

# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`) — encrypts
# payment_gateways.config_json (Daraja/KopoKopo credentials at rest).
GATEWAY_CONFIG_KEY=

# Bearer token required on POST /api/cron/reconcile-payments.
CRON_SECRET=
